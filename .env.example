# Google Sheets — 프로젝트 목록 (CSV 공개 URL)
# 시트: 파일 → 공유 → 웹에 게시 → CSV → URL 복사
GOOGLE_SHEETS_PROJECTS_CSV_URL=

# Google Sheets — 채용 공고 탭 (CSV 공개 URL)
GOOGLE_SHEETS_CAREERS_CSV_URL=

# Kakao Map — JavaScript 키 (문의 페이지 오시는 길)
# developers.kakao.com → 앱 → 플랫폼 키 → JavaScript 키
# JavaScript SDK 도메인에 localhost, maxskill-b2b.vercel.app 등록
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

